# Public production website URL used for SEO metadata and sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Server-only canonical URL for Stripe checkout redirects.
SITE_URL=http://localhost:3000
# Optional: enable merchant checkout with a Stripe test key first.
# Do not commit keys. Configure real values in deployment environment settings.
STRIPE_SECRET_KEY=
# Comma-separated ISO country codes supported by your fulfillment operation.
STORE_COUNTRIES=
